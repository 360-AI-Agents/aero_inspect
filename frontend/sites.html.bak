<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>AeroInspect AI | Sites</title>
<script src="https://cdn.tailwindcss.com"></script>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@600;700;800&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@500&display=swap" rel="stylesheet">
<script>
  tailwind.config = {
    theme: { extend: {
      colors: { primary: '#059669', 'primary-dark': '#047857', 'on-surface': '#191c1e', 'on-surface-variant': '#3d4a42', outline: '#6d7a72', 'outline-variant': '#bccac0', bg: '#f7f9fc', error: '#ba1a1a', tertiary: '#b15f00' },
      fontFamily: { headline: ['Plus Jakarta Sans'], body: ['Inter'], mono: ['JetBrains Mono'] }
    }}
  }
</script>
<style>
  .live-dot { width: 8px; height: 8px; border-radius: 50%; display: inline-block; animation: pulse 2s infinite; }
  @keyframes pulse { 0%,100% { opacity: 1; transform: scale(1); } 50% { opacity: 0.5; transform: scale(1.2); } }
  .modal-overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 100; align-items: center; justify-content: center; }
  .modal-overlay.open { display: flex; }
</style>
</head>
<body class="bg-bg text-on-surface font-body">

<aside class="w-[240px] h-screen fixed left-0 top-0 bg-[#2d3b45] flex flex-col py-6 z-50">
  <div class="px-6 mb-8">
    <h1 class="font-headline text-xl font-bold text-white">AeroInspect AI</h1>
    <p class="text-[11px] text-white/50 uppercase tracking-widest mt-1">Enterprise Hub</p>
  </div>
  <nav class="flex-1 px-3 space-y-1">
    <a href="index.html" class="flex items-center gap-3 px-4 py-3 text-white/60 hover:text-white hover:bg-white/5 rounded-lg transition-colors">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-5 h-5"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
      Dashboard
    </a>
    <a href="inspections.html" class="flex items-center gap-3 px-4 py-3 text-white/60 hover:text-white hover:bg-white/5 rounded-lg transition-colors">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-5 h-5"><path d="M23 7l-7 5 7 5V7z"/><rect x="1" y="5" width="15" height="14" rx="2"/></svg>
      Live Monitoring
    </a>
    <a href="cameras.html" class="flex items-center gap-3 px-4 py-3 text-white/60 hover:text-white hover:bg-white/5 rounded-lg transition-colors">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-5 h-5"><path d="M23 19a2 2 0 01-2 2H3a2 2 0 01-2-2V8a2 2 0 012-2h4l2-3h6l2 3h4a2 2 0 012 2z"/><circle cx="12" cy="13" r="4"/></svg>
      Cameras
    </a>
    <a href="sites.html" class="flex items-center gap-3 px-4 py-3 border-l-4 border-primary bg-primary/10 text-primary font-bold rounded-r-lg">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-5 h-5"><path d="M3 21h18M5 21V7l8-4v18M13 21V11l6 3v7"/></svg>
      Sites
    </a>
    <a href="alerts.html" class="flex items-center gap-3 px-4 py-3 text-white/60 hover:text-white hover:bg-white/5 rounded-lg transition-colors">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-5 h-5"><path d="M18 8A6 6 0 006 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 01-3.46 0"/></svg>
      Alerts
    </a>
    <a href="safety-management.html" data-admin-only="true" class="flex items-center gap-3 px-4 py-3 text-white/60 hover:text-white hover:bg-white/5 rounded-lg transition-colors">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-5 h-5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
      Safety Management
    </a>
    <a href="reports.html" class="flex items-center gap-3 px-4 py-3 text-white/60 hover:text-white hover:bg-white/5 rounded-lg transition-colors">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-5 h-5"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><path d="M14 2v6h6M16 13H8M16 17H8M10 9H8"/></svg>
      Reports
    </a>
    <a href="analytics.html" class="flex items-center gap-3 px-4 py-3 text-white/60 hover:text-white hover:bg-white/5 rounded-lg transition-colors">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-5 h-5"><path d="M18 20V10M12 20V4M6 20v-6"/></svg>
      Analytics
    </a>
    <a href="users.html" data-admin-only="true" class="flex items-center gap-3 px-4 py-3 text-white/60 hover:text-white hover:bg-white/5 rounded-lg transition-colors">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-5 h-5"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"/></svg>
      Users
    </a>
    <a href="settings.html" data-admin-only="true" class="flex items-center gap-3 px-4 py-3 text-white/60 hover:text-white hover:bg-white/5 rounded-lg transition-colors">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-5 h-5"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 11-2.83 2.83l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 01-4 0v-.09A1.65 1.65 0 009 19.4a1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 11-2.83-2.83l.06-.06a1.65 1.65 0 00.33-1.82 1.65 1.65 0 00-1.51-1H3a2 2 0 010-4h.09A1.65 1.65 0 004.6 9a1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 112.83-2.83l.06.06a1.65 1.65 0 001.82.33H9a1.65 1.65 0 001-1.51V3a2 2 0 014 0v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 112.83 2.83l-.06.06a1.65 1.65 0 00-.33 1.82V9a1.65 1.65 0 001.51 1H21a2 2 0 010 4h-.09a1.65 1.65 0 00-1.51 1z"/></svg>
      Settings
    </a>
  </nav>
</aside>

<main class="ml-[240px] min-h-screen relative">
  <header class="h-16 fixed top-0 right-0 w-[calc(100%-240px)] z-40 bg-white/80 backdrop-blur-md border-b border-outline-variant/10 flex justify-between items-center px-8">
    <div class="relative w-96">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-outline"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
      <input id="global-search" placeholder="Search sites, cameras, or reports..." autocomplete="off" class="w-full bg-[#f2f4f7] border-none rounded-lg pl-10 pr-4 py-2 text-sm focus:ring-2 focus:ring-primary/30 outline-none">
      <div id="search-results" class="hidden absolute top-11 left-0 right-0 bg-white border border-outline-variant/20 rounded-xl shadow-xl max-h-80 overflow-y-auto z-50"></div>
    </div>
    <div id="user-badge" class="flex items-center gap-3"></div>
  </header>

  <div class="pt-16">
    <section class="relative h-[220px] overflow-hidden">
      <div class="absolute inset-0 bg-cover bg-center" style="background-image:url('https://images.unsplash.com/photo-1541888946425-d81bb19240f5?w=1600&q=80')"></div>
      <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/40 to-transparent"></div>
      <div class="relative h-full px-8 flex flex-col justify-end pb-8">
        <div class="flex justify-between items-end">
          <div class="text-white">
            <h2 class="font-headline text-3xl font-bold mb-2">Active Sites</h2>
            <p class="text-white/90 max-w-2xl text-sm" id="hero-subtitle">Loading site data…</p>
          </div>
          <button onclick="openRegisterModal()" class="bg-primary text-white px-6 py-3 rounded-lg font-bold flex items-center gap-2 shadow-lg hover:bg-primary-dark transition-colors">📍 Register New Site</button>
        </div>
      </div>
    </section>

    <div class="px-8 py-5 flex justify-between items-center bg-white border-b border-outline-variant/10 sticky top-16 z-30">
      <div class="flex gap-3">
        <button id="filter-all" onclick="setFilter('all')" class="px-4 py-2 rounded-full text-sm font-semibold border transition-colors"></button>
        <button id="filter-attention" onclick="setFilter('attention')" class="px-4 py-2 rounded-full text-sm font-semibold border transition-colors"></button>
      </div>
      <div class="flex items-center gap-8">
        <div class="flex flex-col items-end">
          <span class="text-xs text-outline">System Health</span>
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-primary live-dot"></span>
            <span class="font-mono text-primary text-sm" id="system-health">—</span>
          </div>
        </div>
        <div class="flex items-center gap-1 bg-[#eceef1] p-1 rounded-lg">
          <button id="view-grid-btn" onclick="setView('grid')" class="p-1.5 bg-white shadow-sm rounded-md text-primary">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-5 h-5"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
          </button>
          <button id="view-list-btn" onclick="setView('list')" class="p-1.5 text-outline hover:text-on-surface">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-5 h-5"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
          </button>
        </div>
      </div>
    </div>

    <div class="p-8">
      <div id="sites-grid" class="grid grid-cols-3 gap-6"></div>
      <div id="sites-list" class="hidden space-y-3"></div>
      <div id="sites-empty" class="hidden text-center py-12 text-outline text-sm">No sites yet — register a camera with a location first.</div>
    </div>
  </div>
</main>

<div class="modal-overlay" id="register-modal">
  <div class="bg-white rounded-2xl p-8 w-full max-w-md shadow-2xl">
    <h2 class="font-headline text-xl font-bold mb-2">Register New Site</h2>
    <p class="text-xs text-outline mb-6">A site is created by registering its first camera. Fill in the details below.</p>
    <form onsubmit="submitNewSite(event)">
      <div class="mb-4">
        <label class="block text-xs font-semibold text-outline mb-1.5 uppercase">Site / Location Name</label>
        <input id="new-site-location" type="text" required placeholder="e.g. Skyline Tower A" class="w-full px-4 py-3 bg-[#f2f4f7] border border-outline-variant rounded-xl focus:ring-2 focus:ring-primary outline-none">
      </div>
      <div class="mb-4">
        <label class="block text-xs font-semibold text-outline mb-1.5 uppercase">Camera Name</label>
        <input id="new-site-camera-name" type="text" required placeholder="e.g. Main Entrance Cam" class="w-full px-4 py-3 bg-[#f2f4f7] border border-outline-variant rounded-xl focus:ring-2 focus:ring-primary outline-none">
      </div>
      <div class="mb-6">
        <label class="block text-xs font-semibold text-outline mb-1.5 uppercase">Source Type</label>
        <select id="new-site-source" class="w-full px-4 py-3 bg-[#f2f4f7] border border-outline-variant rounded-xl focus:ring-2 focus:ring-primary outline-none">
          <option value="cctv">CCTV</option>
          <option value="drone">Drone</option>
        </select>
      </div>
      <div class="flex gap-3 justify-end">
        <button type="button" onclick="closeRegisterModal()" class="px-5 py-2.5 border border-outline-variant rounded-lg font-semibold text-sm hover:bg-gray-50">Cancel</button>
        <button type="submit" class="px-5 py-2.5 bg-primary text-white rounded-lg font-bold text-sm hover:bg-primary-dark">Register Site</button>
      </div>
    </form>
  </div>
</div>

<script src="js/api.js"></script>
<script src="js/auth.js"></script>
<script src="js/search.js"></script>
<script src="js/sites.js"></script>
</body>
</html>